{% comment %} Glow Party {% endcomment %}

{%- liquid
  assign slide_count = 0
  for block in section.blocks
    if block.type == 'image_slide'
      assign slide_count = slide_count | plus: 1
    endif
  endfor
-%}

{% style %}
  .gp {
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px;
    width: 100%;
  }
  .gp__layout {
    width: 100%;
    padding: 0 16px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .gp__media { width: 100%; }
  .gp__slider {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 12px;
  }
  .gp__track {
    display: flex;
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: transform;
  }
  .gp__slide {
    flex: 0 0 100%;
    min-width: 0;
    aspect-ratio: var(--slide-ar, 4 / 5);
    overflow: hidden;
    position: relative;
  }
  .gp__slide-img {
    display: block;
    width: 100%;
    height: 100%;
  }
  .gp__slide-placeholder {
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.04);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gp__slide-placeholder svg { width: 40px; height: 40px; opacity: 0.2; }
  .gp__dots {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 7px;
    z-index: 2;
  }
  .gp__dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    border: none; padding: 0;
    cursor: pointer;
    background: rgba(255,255,255,0.45);
    transition: background 0.2s, transform 0.2s;
  }
  .gp__dot--active { background: #fff; transform: scale(1.3); }
  .gp__content {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .gp__eyebrow {
    margin: 0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
  }
  .gp__title {
    margin: 0;
    font-size: clamp(32px, 8vw, 48px);
    font-weight: 700;
    line-height: 1.08;
    color: {{ section.settings.text_color }};
  }
  .gp__descriptor {
    margin: 0;
    font-size: 14px;
    color: {{ section.settings.subtle_text_color }};
    border-left: 2px solid {{ section.settings.accent_color }};
    padding-left: 14px;
    line-height: 1.6;
  }
  .gp__body { font-size: 15px; line-height: 1.7; color: {{ section.settings.text_color }}; }
  .gp__body p { margin: 0 0 0.7em; }
  .gp__body p:last-child { margin-bottom: 0; }
  .gp__includes {
    background: rgba(0,0,0,0.03);
    border-radius: 12px;
    padding: 20px 22px;
  }
  .gp__includes-heading {
    margin: 0 0 12px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
  }
  .gp__includes-list {
    list-style: none;
    margin: 0; padding: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .gp__includes-item {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 14px;
    line-height: 1.5;
  }
  .gp__includes-item::before {
    content: '';
    flex-shrink: 0;
    width: 5px; height: 5px;
    border-radius: 50%;
    background: {{ section.settings.accent_color }};
    position: relative;
    top: -1px;
  }
  .gp__meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .gp__meta-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: rgba(0,0,0,0.03);
    border-radius: 10px;
    padding: 14px 16px;
  }
  .gp__meta-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
  }
  .gp__meta-value { font-size: 14px; font-weight: 500; line-height: 1.4; }
  .gp__note {
    margin: 0;
    font-size: 13px;
    color: {{ section.settings.subtle_text_color }};
    line-height: 1.6;
  }
  .gp__app-block { width: 100%; }
  .gp__html-block { width: 100%; }
  .gp__fine-print {
    border-top: 1px solid rgba(0,0,0,0.08);
    padding-top: 12px;
  }
  .gp__fine-print-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    list-style: none;
    cursor: pointer;
    user-select: none;
    padding: 4px 0;
  }
  .gp__fine-print-toggle::-webkit-details-marker { display: none; }
  .gp__fine-print-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: {{ section.settings.subtle_text_color }};
  }
  .gp__fine-print-chevron {
    transition: transform 0.2s ease;
    flex-shrink: 0;
    color: {{ section.settings.subtle_text_color }};
  }
  details[open] .gp__fine-print-chevron { transform: rotate(180deg); }
  .gp__fine-print-body {
    padding: 10px 0 4px;
    font-size: 12px;
    line-height: 1.7;
    color: {{ section.settings.subtle_text_color }};
  }
  .gp__fine-print-body p { margin: 0 0 0.7em; }
  .gp__fine-print-body p:last-child { margin-bottom: 0; }

  @media (min-width: 750px) {
    .gp__layout {
      flex-direction: row;
      gap: 40px;
      padding: 0 40px;
      align-items: flex-start;
    }
    .gp__media {
      flex: 0 0 50%;
      max-width: 50%;
      position: sticky;
      top: 20px;
    }
    .gp__content {
      flex: 1 1 0%;
      min-width: 0;
      gap: 18px;
    }
    .gp__slider { border-radius: 16px; }
  }
  @media (min-width: 990px) {
    .gp__layout {
      gap: 56px;
      padding: 0 56px;
    }
  }
{% endstyle %}

<section class="gp" id="glow-party-{{ section.id }}">
  <div class="gp__layout">

    {%- if slide_count > 0 -%}
      <div class="gp__media" data-gp-media>
        <div class="gp__slider" data-gp-slider>
          <div class="gp__track" data-gp-track style="width: {{ slide_count | times: 100 }}%">
            {%- for block in section.blocks -%}
              {%- if block.type == 'image_slide' -%}
                {%- liquid
                  assign s_ar  = block.settings.aspect_ratio | default: '4/5'
                  assign s_fit = block.settings.object_fit | default: 'cover'
                  assign s_pos = block.settings.object_position | default: 'center center'
                -%}
                <div
                  class="gp__slide"
                  {{ block.shopify_attributes }}
                  {% if s_ar != 'auto' %}style="--slide-ar: {{ s_ar | replace: '/', ' / ' }};"{% endif %}
                >
                  {%- if block.settings.image != blank -%}
                    <img
                      class="gp__slide-img"
                      src="{{ block.settings.image | image_url: width: 1000 }}"
                      alt="{{ block.settings.image.alt | default: section.settings.title | escape }}"
                      loading="lazy"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                      style="object-fit: {{ s_fit }}; object-position: {{ s_pos }};"
                    >
                  {%- else -%}
                    <div class="gp__slide-placeholder">{{ 'image' | placeholder_svg_tag }}</div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- if slide_count > 1 -%}
            <div class="gp__dots" data-gp-dots>
              {%- for i in (1..slide_count) -%}
                <button
                  class="gp__dot{% if forloop.first %} gp__dot--active{% endif %}"
                  data-gp-dot="{{ forloop.index0 }}"
                  type="button"
                  aria-label="Slide {{ i }}"
                ></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="gp__content">

      {%- if section.settings.eyebrow != blank -%}
        <p class="gp__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h2 class="gp__title">{{ section.settings.title }}</h2>

      {%- if section.settings.descriptor != blank -%}
        <p class="gp__descriptor">{{ section.settings.descriptor }}</p>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="gp__body">{{ section.settings.description }}</div>
      {%- endif -%}

      {%- if section.settings.whats_included != blank -%}
        <div class="gp__includes">
          <p class="gp__includes-heading">{{ section.settings.includes_heading | default: "What's Included" }}</p>
          <ul class="gp__includes-list">
            {%- assign items = section.settings.whats_included | newline_to_br | split: '<br />' -%}
            {%- for item in items -%}
              {%- assign clean = item | strip | remove: '* ' | remove: '- ' -%}
              {%- if clean != blank -%}
                <li class="gp__includes-item">{{ clean }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="gp__meta">
        {%- if section.settings.when != blank -%}
          <div class="gp__meta-card">
            <span class="gp__meta-label">When</span>
            <span class="gp__meta-value">{{ section.settings.when }}</span>
          </div>
        {%- endif -%}
        {%- if section.settings.price != blank -%}
          <div class="gp__meta-card">
            <span class="gp__meta-label">Price</span>
            <span class="gp__meta-value">{{ section.settings.price }}</span>
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.booking_note != blank -%}
        <p class="gp__note">{{ section.settings.booking_note }}</p>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <div class="gp__app-block" {{ block.shopify_attributes }}>{% render block %}</div>
        {%- endif -%}
        {%- if block.type == 'custom_html' -%}
          <div class="gp__html-block" {{ block.shopify_attributes }}>{{ block.settings.html }}</div>
        {%- endif -%}
      {%- endfor -%}

      {%- if section.settings.fine_print != blank -%}
        <details class="gp__fine-print">
          <summary class="gp__fine-print-toggle">
            <span class="gp__fine-print-label">{{ section.settings.fine_print_label | default: 'Fine Print' }}</span>
            <svg class="gp__fine-print-chevron" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 5l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </summary>
          <div class="gp__fine-print-body">{{ section.settings.fine_print }}</div>
        </details>
      {%- endif -%}

    </div>
  </div>
</section>

<script>
(function(){
  function init(el){
    var track=el.querySelector('[data-gp-track]');
    if(!track)return;
    var slides=track.querySelectorAll('.gp__slide');
    var dots=el.querySelectorAll('[data-gp-dot]');
    var n=slides.length,cur=0;
    if(n<2)return;
    function go(i){
      cur=((i%n)+n)%n;
      track.style.transform='translateX(-'+(cur*100/n)+'%)';
      dots.forEach(function(d,j){d.classList.toggle('gp__dot--active',j===cur);});
    }
    dots.forEach(function(d){d.addEventListener('click',function(){go(+d.dataset.gpDot);});});
    var tx=0;
    track.addEventListener('touchstart',function(e){tx=e.touches[0].clientX;},{passive:true});
    track.addEventListener('touchend',function(e){var dx=tx-e.changedTouches[0].clientX;if(Math.abs(dx)>30)go(dx>0?cur+1:cur-1);},{passive:true});
  }
  document.querySelectorAll('[id^="glow-party-"]').forEach(init);
  if(window.Shopify&&Shopify.designMode)document.addEventListener('shopify:section:load',function(e){init(e.target);});
})();
</script>

{% schema %}
{
  "name": "Glow Party",
  "tag": "section",
  "class": "glow-party-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "header", "content": "Text" },
    { "type": "text",     "id": "eyebrow",     "label": "Eyebrow",     "default": "A Private Skincare Night Out for You + Your Friends" },
    { "type": "text",     "id": "title",        "label": "Title",       "default": "Glow Party" },
    { "type": "text",     "id": "descriptor",   "label": "Descriptor",  "default": "Private Skin Analysis + After-Hours Shopping · Available on select Sundays only. Limited private bookings each month." },
    { "type": "richtext", "id": "description",  "label": "Description", "default": "<p>Celebrate, catch up, and glow together.</p><p>Glow Party is a private after-hours skincare experience for small groups at Seoul Glow Lab. Bring your friends and enjoy personalized skin analysis, routine guidance, and private shopping while the store is closed just for you.</p><p>Perfect for birthdays, girls' nights, or a unique skincare outing.</p>" },
    { "type": "header", "content": "What's Included" },
    { "type": "text",     "id": "includes_heading", "label": "Heading", "default": "What's Included" },
    { "type": "textarea", "id": "whats_included",   "label": "Items (one per line)", "default": "* Private access to Seoul Glow Lab\n* Up to 4 guests\n* Individual professional skin analysis for each guest\n* Personalized routine recommendations\n* Private shopping experience\n* Mocktails + champagne\n* 10% off purchases during your visit" },
    { "type": "header", "content": "When & Price" },
    { "type": "text", "id": "when",  "label": "When",  "default": "Select Sundays · 5:00–7:00 PM (after closing)" },
    { "type": "text", "id": "price", "label": "Price", "default": "$495 per group (up to 4 guests)" },
    { "type": "header", "content": "Booking" },
    { "type": "textarea", "id": "booking_note", "label": "Note above form", "default": "Submit the request form below and our team will follow up to confirm your date." },
    { "type": "header", "content": "Fine Print" },
    { "type": "text",     "id": "fine_print_label", "label": "Label",   "default": "Fine Print" },
    { "type": "richtext", "id": "fine_print",        "label": "Content", "default": "<p>Add your cancellation policy, booking terms, and any other details here.</p>" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color",  "label": "Background",  "default": "#fdf6f2" },
    { "type": "color", "id": "accent_color",      "label": "Accent",      "default": "#c084a0" },
    { "type": "color", "id": "text_color",         "label": "Text",        "default": "#1a1a1a" },
    { "type": "color", "id": "subtle_text_color",  "label": "Subtle text", "default": "#6b6b6b" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "section_padding_top",    "label": "Top",    "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "section_padding_bottom", "label": "Bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "image_slide",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select", "id": "aspect_ratio", "label": "Crop",
          "options": [
            { "value": "auto",  "label": "Natural" },
            { "value": "1/1",   "label": "Square" },
            { "value": "4/5",   "label": "Portrait 4:5" },
            { "value": "3/4",   "label": "Tall 3:4" },
            { "value": "4/3",   "label": "Landscape 4:3" },
            { "value": "16/9",  "label": "Wide 16:9" }
          ],
          "default": "4/5"
        },
        {
          "type": "select", "id": "object_fit", "label": "Fit",
          "options": [
            { "value": "cover",   "label": "Fill (crop)" },
            { "value": "contain", "label": "Fit (no crop)" }
          ],
          "default": "cover"
        },
        {
          "type": "select", "id": "object_position", "label": "Focus",
          "options": [
            { "value": "center center",  "label": "Center" },
            { "value": "top center",     "label": "Top" },
            { "value": "bottom center",  "label": "Bottom" },
            { "value": "center left",    "label": "Left" },
            { "value": "center right",   "label": "Right" },
            { "value": "top left",       "label": "Top left" },
            { "value": "top right",      "label": "Top right" },
            { "value": "bottom left",    "label": "Bottom left" },
            { "value": "bottom right",   "label": "Bottom right" }
          ],
          "default": "center center"
        }
      ]
    },
    { "type": "@app" },
    {
      "type": "custom_html",
      "name": "Custom HTML",
      "settings": [
        { "type": "html", "id": "html", "label": "HTML" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glow Party",
      "blocks": [
        { "type": "image_slide" }
      ]
    }
  ]
}
{% endschema %}
