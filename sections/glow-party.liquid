{% comment %}
  Glow Party Section
  - 3 image pickers with controlled aspect ratio + fixed height option
  - Font size range sliders for every text element
  - App block support for form embeds
  - Collapsible fine print
  - No CTA button
{% endcomment %}

{{ 'glow-party.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign image_count = 0
  if section.settings.image_1 != blank
    assign image_count = image_count | plus: 1
  endif
  if section.settings.image_2 != blank
    assign image_count = image_count | plus: 1
  endif
  if section.settings.image_3 != blank
    assign image_count = image_count | plus: 1
  endif
-%}

<section
  class="glow-party"
  id="glow-party-{{ section.id }}"
  style="
    --gp-color-bg: {{ section.settings.background_color }};
    --gp-color-accent: {{ section.settings.accent_color }};
    --gp-color-text: {{ section.settings.text_color }};
    --gp-color-subtle: {{ section.settings.subtle_text_color }};
    --gp-pt: {{ section.settings.section_padding_top }}px;
    --gp-pb: {{ section.settings.section_padding_bottom }}px;
    --gp-img-ratio: {{ section.settings.image_aspect_ratio }};
    --gp-img-height: {{ section.settings.image_height }}px;
    --gp-fs-eyebrow: {{ section.settings.font_size_eyebrow }}px;
    --gp-fs-title: {{ section.settings.font_size_title }}px;
    --gp-fs-descriptor: {{ section.settings.font_size_descriptor }}px;
    --gp-fs-description: {{ section.settings.font_size_description }}px;
    --gp-fs-includes: {{ section.settings.font_size_includes }}px;
    --gp-fs-meta-label: {{ section.settings.font_size_meta_label }}px;
    --gp-fs-meta-value: {{ section.settings.font_size_meta_value }}px;
    --gp-fs-booking: {{ section.settings.font_size_booking }}px;
    --gp-fs-fine-print: {{ section.settings.font_size_fine_print }}px;
  "
>
  <div class="glow-party__inner">

    {%- comment -%} ── IMAGES ── {%- endcomment -%}
    {%- if image_count > 0 -%}
      <div class="glow-party__gallery glow-party__gallery--{{ image_count }}up">

        {%- if section.settings.image_1 != blank -%}
          <div class="glow-party__gallery-item glow-party__gallery-item--main">
            <div class="glow-party__img-wrap">
              {{
                section.settings.image_1
                | image_url: width: 1400
                | image_tag:
                  loading: 'lazy',
                  alt: section.settings.image_1.alt | default: section.settings.title,
                  class: 'glow-party__img',
                  widths: '400, 600, 800, 1000, 1200, 1400',
                  sizes: '(max-width: 900px) 100vw, 50vw'
              }}
            </div>
          </div>
        {%- endif -%}

        {%- if section.settings.image_2 != blank -%}
          <div class="glow-party__gallery-item">
            <div class="glow-party__img-wrap">
              {{
                section.settings.image_2
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  alt: section.settings.image_2.alt | default: section.settings.title,
                  class: 'glow-party__img',
                  widths: '400, 600, 800',
                  sizes: '(max-width: 900px) 50vw, 25vw'
              }}
            </div>
          </div>
        {%- endif -%}

        {%- if section.settings.image_3 != blank -%}
          <div class="glow-party__gallery-item">
            <div class="glow-party__img-wrap">
              {{
                section.settings.image_3
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  alt: section.settings.image_3.alt | default: section.settings.title,
                  class: 'glow-party__img',
                  widths: '400, 600, 800',
                  sizes: '(max-width: 900px) 50vw, 25vw'
              }}
            </div>
          </div>
        {%- endif -%}

      </div>
    {%- endif -%}

    {%- comment -%} ── CONTENT ── {%- endcomment -%}
    <div class="glow-party__content">

      {%- if section.settings.eyebrow != blank -%}
        <p class="glow-party__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h2 class="glow-party__title">{{ section.settings.title }}</h2>

      {%- if section.settings.descriptor != blank -%}
        <p class="glow-party__descriptor">{{ section.settings.descriptor }}</p>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="glow-party__description">{{ section.settings.description }}</div>
      {%- endif -%}

      {%- if section.settings.whats_included != blank -%}
        <div class="glow-party__includes">
          <p class="glow-party__includes-heading">{{ section.settings.includes_heading | default: "What's Included" }}</p>
          <ul class="glow-party__includes-list">
            {%- assign items = section.settings.whats_included | newline_to_br | split: '<br />' -%}
            {%- for item in items -%}
              {%- assign clean = item | strip | remove: '* ' | remove: '- ' -%}
              {%- if clean != blank -%}
                <li>{{ clean }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="glow-party__meta">
        {%- if section.settings.when != blank -%}
          <div class="glow-party__meta-item">
            <span class="glow-party__meta-label">When</span>
            <span class="glow-party__meta-value">{{ section.settings.when }}</span>
          </div>
        {%- endif -%}
        {%- if section.settings.price != blank -%}
          <div class="glow-party__meta-item">
            <span class="glow-party__meta-label">Price</span>
            <span class="glow-party__meta-value">{{ section.settings.price }}</span>
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.booking_note != blank -%}
        <p class="glow-party__booking-note">{{ section.settings.booking_note }}</p>
      {%- endif -%}

      {%- comment -%} ── APP / CUSTOM BLOCKS ── {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            <div class="glow-party__app-block" {{ block.shopify_attributes }}>
              {% render block %}
            </div>
          {%- when 'custom_html' -%}
            <div class="glow-party__custom-html" {{ block.shopify_attributes }}>
              {{ block.settings.html }}
            </div>
        {%- endcase -%}
      {%- endfor -%}

      {%- comment -%} ── FINE PRINT COLLAPSIBLE ── {%- endcomment -%}
      {%- if section.settings.fine_print != blank -%}
        <details class="glow-party__fine-print">
          <summary class="glow-party__fine-print-toggle">
            {{ section.settings.fine_print_label | default: 'Fine Print' }}
            <span class="glow-party__fine-print-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M2 5L7 10L12 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </summary>
          <div class="glow-party__fine-print-body">
            {{ section.settings.fine_print }}
          </div>
        </details>
      {%- endif -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Glow Party",
  "tag": "section",
  "class": "glow-party-section",
  "settings": [

    { "type": "header", "content": "Images" },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1 (main)"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "1/1",  "label": "Square (1:1)" },
        { "value": "4/3",  "label": "Landscape (4:3)" },
        { "value": "3/4",  "label": "Portrait (3:4)" },
        { "value": "16/9", "label": "Wide (16:9)" },
        { "value": "none", "label": "Fixed height (use slider below)" }
      ],
      "default": "4/3"
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Fixed height (only when aspect ratio = Fixed height)",
      "min": 200,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 500
    },

    { "type": "header", "content": "Text Content" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A Private Skincare Night Out for You + Your Friends"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Glow Party"
    },
    {
      "type": "text",
      "id": "descriptor",
      "label": "Descriptor (under title)",
      "default": "Private Skin Analysis + After-Hours Shopping · Available on select Sundays only. Limited private bookings each month."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Celebrate, catch up, and glow together.</p><p>Glow Party is a private after-hours skincare experience for small groups at Seoul Glow Lab. Bring your friends and enjoy personalized skin analysis, routine guidance, and private shopping while the store is closed just for you.</p><p>Perfect for birthdays, girls' nights, or a unique skincare outing.</p>"
    },

    { "type": "header", "content": "What's Included" },
    {
      "type": "text",
      "id": "includes_heading",
      "label": "Heading",
      "default": "What's Included"
    },
    {
      "type": "textarea",
      "id": "whats_included",
      "label": "Items (one per line, optionally prefix with * or -)",
      "default": "* Private access to Seoul Glow Lab\n* Up to 4 guests\n* Individual professional skin analysis for each guest\n* Personalized routine recommendations\n* Private shopping experience\n* Mocktails + champagne\n* 10% off purchases during your visit"
    },

    { "type": "header", "content": "When & Price" },
    {
      "type": "text",
      "id": "when",
      "label": "When",
      "default": "Select Sundays · 5:00\u20137:00 PM (after closing)"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "$495 per group (up to 4 guests)"
    },

    { "type": "header", "content": "Booking Note" },
    {
      "type": "textarea",
      "id": "booking_note",
      "label": "Note above form",
      "default": "Submit the request form below and our team will follow up to confirm your date."
    },

    { "type": "header", "content": "Fine Print" },
    {
      "type": "text",
      "id": "fine_print_label",
      "label": "Collapsible label",
      "default": "Fine Print"
    },
    {
      "type": "richtext",
      "id": "fine_print",
      "label": "Fine print content",
      "default": "<p>Add your cancellation policy, booking terms, and any other details here.</p>"
    },

    { "type": "header", "content": "Font Sizes" },
    {
      "type": "range",
      "id": "font_size_eyebrow",
      "label": "Eyebrow",
      "min": 10, "max": 24, "step": 1, "unit": "px", "default": 11
    },
    {
      "type": "range",
      "id": "font_size_title",
      "label": "Title",
      "min": 24, "max": 96, "step": 2, "unit": "px", "default": 56
    },
    {
      "type": "range",
      "id": "font_size_descriptor",
      "label": "Descriptor",
      "min": 12, "max": 24, "step": 1, "unit": "px", "default": 14
    },
    {
      "type": "range",
      "id": "font_size_description",
      "label": "Description body",
      "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16
    },
    {
      "type": "range",
      "id": "font_size_includes",
      "label": "Included items",
      "min": 12, "max": 22, "step": 1, "unit": "px", "default": 15
    },
    {
      "type": "range",
      "id": "font_size_meta_label",
      "label": "When / Price label",
      "min": 9, "max": 18, "step": 1, "unit": "px", "default": 11
    },
    {
      "type": "range",
      "id": "font_size_meta_value",
      "label": "When / Price value",
      "min": 12, "max": 24, "step": 1, "unit": "px", "default": 15
    },
    {
      "type": "range",
      "id": "font_size_booking",
      "label": "Booking note",
      "min": 12, "max": 22, "step": 1, "unit": "px", "default": 14
    },
    {
      "type": "range",
      "id": "font_size_fine_print",
      "label": "Fine print body",
      "min": 10, "max": 18, "step": 1, "unit": "px", "default": 13
    },

    { "type": "header", "content": "Colors" },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#fdf6f2"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#c084a0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "subtle_text_color",
      "label": "Subtle / secondary text",
      "default": "#6b6b6b"
    },

    { "type": "header", "content": "Spacing" },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Padding top",
      "min": 0, "max": 120, "step": 8, "unit": "px", "default": 80
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Padding bottom",
      "min": 0, "max": 120, "step": 8, "unit": "px", "default": 80
    }
  ],

  "blocks": [
    { "type": "@app" },
    {
      "type": "custom_html",
      "name": "Custom HTML",
      "settings": [
        {
          "type": "html",
          "id": "html",
          "label": "HTML"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Glow Party",
      "category": "Custom"
    }
  ]
}
{% endschema %}
