{% comment %}
  Glow Party Section
  - Custom image picker (up to 3 images)
  - App block support (for form apps like EmbedForms, TypeForm embed, etc.)
  - Collapsible fine print tab
  - No hardcoded CTA button
{% endcomment %}

{{ 'glow-party.css' | asset_url | stylesheet_tag }}

<section
  class="glow-party"
  id="glow-party-{{ section.id }}"
  style="
    --color-bg: {{ section.settings.background_color }};
    --color-accent: {{ section.settings.accent_color }};
    --color-text: {{ section.settings.text_color }};
    --color-subtle: {{ section.settings.subtle_text_color }};
  "
>
  <div class="glow-party__inner">

    {%- comment -%} ── IMAGE GALLERY ── {%- endcomment -%}
    {%- assign image_count = 0 -%}
    {%- if section.settings.image_1 != blank -%}{%- assign image_count = image_count | plus: 1 -%}{%- endif -%}
    {%- if section.settings.image_2 != blank -%}{%- assign image_count = image_count | plus: 1 -%}{%- endif -%}
    {%- if section.settings.image_3 != blank -%}{%- assign image_count = image_count | plus: 1 -%}{%- endif -%}

    {%- if image_count > 0 -%}
    <div class="glow-party__gallery glow-party__gallery--{{ image_count }}up">
      {%- if section.settings.image_1 != blank -%}
        <div class="glow-party__gallery-item glow-party__gallery-item--main">
          {{
            section.settings.image_1
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              alt: section.settings.image_1.alt | default: section.settings.title,
              class: 'glow-party__img'
          }}
        </div>
      {%- endif -%}
      {%- if section.settings.image_2 != blank -%}
        <div class="glow-party__gallery-item">
          {{
            section.settings.image_2
            | image_url: width: 800
            | image_tag:
              loading: 'lazy',
              alt: section.settings.image_2.alt | default: section.settings.title,
              class: 'glow-party__img'
          }}
        </div>
      {%- endif -%}
      {%- if section.settings.image_3 != blank -%}
        <div class="glow-party__gallery-item">
          {{
            section.settings.image_3
            | image_url: width: 800
            | image_tag:
              loading: 'lazy',
              alt: section.settings.image_3.alt | default: section.settings.title,
              class: 'glow-party__img'
          }}
        </div>
      {%- endif -%}
    </div>
    {%- endif -%}

    {%- comment -%} ── CONTENT COLUMN ── {%- endcomment -%}
    <div class="glow-party__content">

      {%- comment -%} Eyebrow / kicker {%- endcomment -%}
      {%- if section.settings.eyebrow != blank -%}
        <p class="glow-party__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- comment -%} Title {%- endcomment -%}
      <h2 class="glow-party__title">{{ section.settings.title }}</h2>

      {%- comment -%} Descriptor {%- endcomment -%}
      {%- if section.settings.descriptor != blank -%}
        <p class="glow-party__descriptor">{{ section.settings.descriptor }}</p>
      {%- endif -%}

      {%- comment -%} Description {%- endcomment -%}
      {%- if section.settings.description != blank -%}
        <div class="glow-party__description">{{ section.settings.description }}</div>
      {%- endif -%}

      {%- comment -%} What's Included {%- endcomment -%}
      {%- if section.settings.whats_included != blank -%}
        <div class="glow-party__includes">
          <h3 class="glow-party__includes-heading">{{ section.settings.includes_heading | default: "What's Included" }}</h3>
          <ul class="glow-party__includes-list">
            {%- assign items = section.settings.whats_included | newline_to_br | split: '<br />' -%}
            {%- for item in items -%}
              {%- assign clean = item | strip | remove: '* ' | remove: '- ' -%}
              {%- if clean != blank -%}
                <li>{{ clean }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- comment -%} Meta pills: When + Price {%- endcomment -%}
      <div class="glow-party__meta">
        {%- if section.settings.when != blank -%}
          <div class="glow-party__meta-item">
            <span class="glow-party__meta-label">When</span>
            <span class="glow-party__meta-value">{{ section.settings.when }}</span>
          </div>
        {%- endif -%}
        {%- if section.settings.price != blank -%}
          <div class="glow-party__meta-item">
            <span class="glow-party__meta-label">Price</span>
            <span class="glow-party__meta-value">{{ section.settings.price }}</span>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Booking note {%- endcomment -%}
      {%- if section.settings.booking_note != blank -%}
        <p class="glow-party__booking-note">{{ section.settings.booking_note }}</p>
      {%- endif -%}

      {%- comment -%} ── APP BLOCKS (form apps, etc.) ── {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when '@app' -%}
            <div class="glow-party__app-block" {{ block.shopify_attributes }}>
              {% render block %}
            </div>

          {%- when 'custom_html' -%}
            <div class="glow-party__custom-html" {{ block.shopify_attributes }}>
              {{ block.settings.html }}
            </div>

        {%- endcase -%}
      {%- endfor -%}

      {%- comment -%} ── FINE PRINT COLLAPSIBLE ── {%- endcomment -%}
      {%- if section.settings.fine_print != blank -%}
        <details class="glow-party__fine-print">
          <summary class="glow-party__fine-print-toggle">
            {{ section.settings.fine_print_label | default: 'Fine Print' }}
            <span class="glow-party__fine-print-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M2 5L7 10L12 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </summary>
          <div class="glow-party__fine-print-body">
            {{ section.settings.fine_print }}
          </div>
        </details>
      {%- endif -%}

    </div>{%- comment -%} end .glow-party__content {%- endcomment -%}
  </div>
</section>

<style>
  #glow-party-{{ section.id }} {
    background-color: var(--color-bg, #fdf6f2);
    color: var(--color-text, #1a1a1a);
    padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px;
  }
</style>

{% schema %}
{
  "name": "Glow Party",
  "tag": "section",
  "class": "glow-party-section",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1 (main / hero)"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow / Kicker",
      "default": "A Private Skincare Night Out for You + Your Friends"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Glow Party"
    },
    {
      "type": "text",
      "id": "descriptor",
      "label": "Descriptor (under title)",
      "default": "Private Skin Analysis + After-Hours Shopping · Available on select Sundays only. Limited private bookings each month."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Celebrate, catch up, and glow together.</p><p>Glow Party is a private after-hours skincare experience for small groups at Seoul Glow Lab. Bring your friends and enjoy personalized skin analysis, routine guidance, and private shopping while the store is closed just for you.</p><p>Perfect for birthdays, girls' nights, or a unique skincare outing.</p>"
    },
    {
      "type": "header",
      "content": "What's Included"
    },
    {
      "type": "text",
      "id": "includes_heading",
      "label": "Section heading",
      "default": "What's Included"
    },
    {
      "type": "textarea",
      "id": "whats_included",
      "label": "Included items (one per line, prefix with * or -)",
      "default": "* Private access to Seoul Glow Lab\n* Up to 4 guests\n* Individual professional skin analysis for each guest\n* Personalized routine recommendations\n* Private shopping experience\n* Mocktails + champagne\n* 10% off purchases during your visit"
    },
    {
      "type": "header",
      "content": "When & Price"
    },
    {
      "type": "text",
      "id": "when",
      "label": "When",
      "default": "Select Sundays · 5:00–7:00 PM (after closing)"
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "$495 per group (up to 4 guests)"
    },
    {
      "type": "header",
      "content": "Booking Note"
    },
    {
      "type": "textarea",
      "id": "booking_note",
      "label": "Booking note (above form)",
      "default": "Submit the request form below and our team will follow up to confirm your date."
    },
    {
      "type": "header",
      "content": "Fine Print"
    },
    {
      "type": "text",
      "id": "fine_print_label",
      "label": "Collapsible tab label",
      "default": "Fine Print"
    },
    {
      "type": "richtext",
      "id": "fine_print",
      "label": "Fine print content",
      "default": "<p>Add your cancellation policy, booking terms, and any other fine print here. This content lives in a collapsible tab.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#fdf6f2"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#c084a0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "subtle_text_color",
      "label": "Subtle text",
      "default": "#6b6b6b"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "custom_html",
      "name": "Custom HTML",
      "settings": [
        {
          "type": "html",
          "id": "html",
          "label": "HTML"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glow Party",
      "category": "Custom"
    }
  ]
}
{% endschema %}
