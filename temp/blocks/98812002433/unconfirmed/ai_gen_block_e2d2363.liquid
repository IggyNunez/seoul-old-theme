{% doc %}
  @prompt
    product section where we can choos eour own images and [6:02 PM, 3/13/2026] Katie Amarantinis: A Private Skincare Night Out for You + Your Friends
     
    Title
    
    Glow Party
     
    Descriptor (underneath title)
    
    Private Skin Analysis + After-Hours Shopping
    Available on select Sundays only. Limited private bookings each month.
     
    Description
    
    Celebrate, catch up, and glow together.
     
    Glow Party is a private after-hours skincare experience for small groups at Seoul Glow Lab. Bring your friends and enjoy personalized skin analysis, routine guidance, and private shopping while the store is closed just for you.
     
    Perfect for birthdays, girls’ nights, or a unique skincare outing.
     
    What’s Included
    
    * Private access to Seoul Glow Lab
    * Up to 4 guests
    * Individual professional skin analysis for each guest
    * Personalized routine recommendations
    * Private shopping experience
    * Mocktails + champagne
    * 10% off purchases during your visit
     
    When
    
    Select Sundays
    5:00–7:00 PM (after closing)
     
    Price
    
    $495 per group (up to 4 guests)
     
    Booking
    
    Submit the request form below and our team will follow up to confirm your date.
    [6:02 PM, 3/13/2026] Katie Amarantinis: And then leave the fine print in the collapsible tab
    [6:03 PM, 3/13/2026] Katie Amarantinis: Also can we Change the button label from something generic like:
     
    ❌ Request Booking
     
    to:
     
    ✅ Request Your Glow
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-glow-party-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-glow-party-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
  }

  .ai-glow-party-images-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .ai-glow-party-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-glow-party-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-glow-party-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-glow-party-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-glow-party-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-glow-party-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-glow-party-descriptor-{{ ai_gen_id }} {
    font-size: {{ block.settings.descriptor_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.4;
  }

  .ai-glow-party-availability-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    margin: 0;
    line-height: 1.5;
  }

  .ai-glow-party-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
  }

  .ai-glow-party-description-{{ ai_gen_id }} p {
    margin: 0 0 16px 0;
  }

  .ai-glow-party-description-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-glow-party-included-{{ ai_gen_id }} {
    background-color: {{ block.settings.included_bg_color }};
    padding: 24px;
    border-radius: {{ block.settings.included_border_radius }}px;
  }

  .ai-glow-party-included-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.section_title_size }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px 0;
  }

  .ai-glow-party-included-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-glow-party-included-item-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    display: flex;
    align-items: flex-start;
    gap: 12px;
    line-height: 1.5;
  }

  .ai-glow-party-included-item-{{ ai_gen_id }}::before {
    content: "✓";
    color: {{ block.settings.checkmark_color }};
    font-weight: 700;
    flex-shrink: 0;
    font-size: 18px;
  }

  .ai-glow-party-details-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .ai-glow-party-detail-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-glow-party-detail-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.section_title_size }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-glow-party-detail-value-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-glow-party-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
  }

  .ai-glow-party-booking-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-glow-party-booking-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.section_title_size }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-glow-party-booking-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-glow-party-button-{{ ai_gen_id }} {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: 16px 32px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
    width: fit-content;
  }

  .ai-glow-party-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-glow-party-collapsible-{{ ai_gen_id }} {
    border-top: 1px solid {{ block.settings.text_color }};
    border-bottom: 1px solid {{ block.settings.text_color }};
    opacity: 0.3;
  }

  .ai-glow-party-collapsible-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 0;
    cursor: pointer;
    background: none;
    border: none;
    width: 100%;
    text-align: left;
  }

  .ai-glow-party-collapsible-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-glow-party-collapsible-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
    color: {{ block.settings.text_color }};
  }

  .ai-glow-party-collapsible-{{ ai_gen_id }}.active .ai-glow-party-collapsible-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-glow-party-collapsible-content-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-glow-party-collapsible-{{ ai_gen_id }}.active .ai-glow-party-collapsible-content-{{ ai_gen_id }} {
    max-height: 1000px;
  }

  .ai-glow-party-collapsible-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    padding-bottom: 16px;
    line-height: 1.6;
  }

