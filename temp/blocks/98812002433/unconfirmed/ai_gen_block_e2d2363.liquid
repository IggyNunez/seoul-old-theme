{% endstyle %}

<glow-party-{{ ai_gen_id }} class="ai-glow-party-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-glow-party-container-{{ ai_gen_id }}">
    <div class="ai-glow-party-images-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% assign image_key = 'image_' | append: i %}
        {% assign image = block.settings[image_key] %}
        <div class="ai-glow-party-image-wrapper-{{ ai_gen_id }}">
          {% if image %}
            <img
              src="{{ image | image_url: width: 600 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="600"
              height="600"
            >
          {% else %}
            <div class="ai-glow-party-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <div class="ai-glow-party-content-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h1 class="ai-glow-party-title-{{ ai_gen_id }}">{{ block.settings.title }}</h1>
      {% endif %}

      {% if block.settings.descriptor != blank %}
        <h2 class="ai-glow-party-descriptor-{{ ai_gen_id }}">{{ block.settings.descriptor }}</h2>
      {% endif %}

      {% if block.settings.availability != blank %}
        <p class="ai-glow-party-availability-{{ ai_gen_id }}">{{ block.settings.availability }}</p>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-glow-party-description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}

      {% if block.settings.show_included %}
        <div class="ai-glow-party-included-{{ ai_gen_id }}">
          {% if block.settings.included_title != blank %}
            <h3 class="ai-glow-party-included-title-{{ ai_gen_id }}">{{ block.settings.included_title }}</h3>
          {% endif %}
          <ul class="ai-glow-party-included-list-{{ ai_gen_id }}">
            {% if block.settings.included_1 != blank %}
              <li class="ai-glow-party-included-item-{{ ai_gen_id }}">{{ block.settings.included_1 }}</li>
            {% endif %}
            {% if block.settings.included_2 != blank %}
              <li class="ai-glow-party-included-item-{{ ai_gen_id }}">{{ block.settings.included_2 }}</li>
            {% endif %}
            {% if block.settings.included_3 != blank %}
              <li class="ai-glow-party-included-item-{{ ai_gen_id }}">{{ block.settings.included_3 }}</li>
            {% endif %}
            {% if block.settings.included_4 != blank %}
              <li class="ai-glow-party-included-item-{{ ai_gen_id }}">{{ block.settings.included_4 }}</li>
            {% endif %}
            {% if block.settings.included_5 != blank %}
              <li class="ai-glow-party-included-item-{{ ai_gen_id }}">{{ block.settings.included_5 }}</li>
            {% endif %}
            {% if block.settings.included_6 != blank %}
              <li class="ai-glow-party-included-item-{{ ai_gen_id }}">{{ block.settings.included_6 }}</li>
            {% endif %}
            {% if block.settings.included_7 != blank %}
              <li class="ai-glow-party-included-item-{{ ai_gen_id }}">{{ block.settings.included_7 }}</li>
            {% endif %}
          </ul>
        </div>
      {% endif %}

      <div class="ai-glow-party-details-{{ ai_gen_id }}">
        {% if block.settings.when_label != blank or block.settings.when_value != blank %}
          <div class="ai-glow-party-detail-{{ ai_gen_id }}">
            {% if block.settings.when_label != blank %}
              <h3 class="ai-glow-party-detail-label-{{ ai_gen_id }}">{{ block.settings.when_label }}</h3>
            {% endif %}
            {% if block.settings.when_value != blank %}
              <div class="ai-glow-party-detail-value-{{ ai_gen_id }}">{{ block.settings.when_value }}</div>
            {% endif %}
          </div>
        {% endif %}

        {% if block.settings.price_label != blank or block.settings.price_value != blank %}
          <div class="ai-glow-party-detail-{{ ai_gen_id }}">
            {% if block.settings.price_label != blank %}
              <h3 class="ai-glow-party-detail-label-{{ ai_gen_id }}">{{ block.settings.price_label }}</h3>
            {% endif %}
            {% if block.settings.price_value != blank %}
              <div class="ai-glow-party-price-{{ ai_gen_id }}">{{ block.settings.price_value }}</div>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <div class="ai-glow-party-booking-{{ ai_gen_id }}">
        {% if block.settings.booking_label != blank %}
          <h3 class="ai-glow-party-booking-title-{{ ai_gen_id }}">{{ block.settings.booking_label }}</h3>
        {% endif %}
        {% if block.settings.booking_text != blank %}
          <p class="ai-glow-party-booking-text-{{ ai_gen_id }}">{{ block.settings.booking_text }}</p>
        {% endif %}
        {% if block.settings.button_text != blank %}
          <a
            href="{{ block.settings.button_link }}"
            class="ai-glow-party-button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_text }}
          </a>
        {% endif %}
      </div>

      {% if block.settings.show_fine_print %}
        <div class="ai-glow-party-collapsible-{{ ai_gen_id }}" data-collapsible>
          <button
            class="ai-glow-party-collapsible-header-{{ ai_gen_id }}"
            aria-expanded="false"
            data-collapsible-trigger
          >
            <h3 class="ai-glow-party-collapsible-title-{{ ai_gen_id }}">{{ block.settings.fine_print_label }}</h3>
            <svg
              class="ai-glow-party-collapsible-icon-{{ ai_gen_id }}"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="ai-glow-party-collapsible-content-{{ ai_gen_id }}" data-collapsible-content>
            {% if block.settings.fine_print_text != blank %}
              <div class="ai-glow-party-collapsible-text-{{ ai_gen_id }}">
                {{ block.settings.fine_print_text }}
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</glow-party-{{ ai_gen_id }}>

<script>
  (function() {
    class GlowParty{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.collapsible = this.querySelector('[data-collapsible]');
        if (this.collapsible) {
          this.trigger = this.collapsible.querySelector('[data-collapsible-trigger]');
          this.content = this.collapsible.querySelector('[data-collapsible-content]');
          
          if (this.trigger && this.content) {
            this.trigger.addEventListener('click', () => this.toggleCollapsible());
          }
        }
      }

      toggleCollapsible() {
        const isActive = this.collapsible.classList.contains('active');
        this.collapsible.classList.toggle('active');
        this.trigger.setAttribute('aria-expanded', !isActive);
      }
    }

    customElements.define('glow-party-{{ ai_gen_id }}', GlowParty{{ ai_gen_id }});
  })();
</script>

